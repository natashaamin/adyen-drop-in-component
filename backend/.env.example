# Adyen test Customer Area > Developers > API credentials
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
# Customer Area > Developers > API credentials > Client key
ADYEN_CLIENT_KEY=
ADYEN_ENVIRONMENT=TEST
# Customer Area > Developers > Webhooks > (your webhook) > HMAC Key
ADYEN_HMAC_KEY=

PORT=8081
# Must match the "Allowed origin" configured for the client key in the Adyen Customer Area.
FRONTEND_URL=http://localhost:8080
